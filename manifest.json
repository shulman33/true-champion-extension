{
  "manifest_version": 3,
  "name": "True Champion for ESPN",
  "version": "1.0.0",
  "description": "Connect your private ESPN fantasy league to True Champion in one click. Securely syncs cookies straight to your account.",
  "homepage_url": "https://github.com/shulman33/true-champion-extension",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.espn.com/*",
    "https://true-champion-app.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://true-champion-app.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
