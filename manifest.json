{
  "manifest_version": 3,
  "name": "True Champion for ESPN",
  "version": "1.2.0",
  "description": "Connect your private ESPN fantasy league to True Champion in one click. Securely syncs cookies straight to your account.",
  "homepage_url": "https://github.com/shulman33/true-champion-extension",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.espn.com/*",
    "https://www.truechampion.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.truechampion.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "True Champion for ESPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
